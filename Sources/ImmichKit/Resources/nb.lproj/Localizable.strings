/* ImmichKit: Norwegian Bokmål. Keys are the English texts. */

/* Memories */
"%@'s birthday" = "%@ har bursdag";
"%lld years ago" = "For %lld år siden";
"1 year ago" = "For 1 år siden";

/* Login errors: titles */
"API Key Required" = "API-nøkkel mangler";
"Cannot Connect to Server" = "Kan ikke koble til serveren";
"Could Not Save Login" = "Kunne ikke lagre påloggingen";
"Invalid Server URL" = "Ugyldig serveradresse";
"Not an Immich Server" = "Ikke en Immich-server";
"Server Error" = "Serverfeil";
"Wrong API Key" = "Feil API-nøkkel";

/* Login errors: messages */
"Enter an API key. Create one on the web under Account Settings › API Keys." = "Skriv inn en API-nøkkel. Du lager en på nettet under Kontoinnstillinger › API-nøkler.";
"Enter the address of your Immich server, for example https://photos.example.com." = "Skriv inn adressen til Immich-serveren din, for eksempel https://photos.example.com.";
"The address answered, but it is not an Immich server. Check the URL and port." = "Adressen svarte, men det er ikke en Immich-server. Sjekk adressen og porten.";
"The connection works, but the login could not be saved to the Keychain." = "Tilkoblingen fungerer, men påloggingen kunne ikke lagres i nøkkelringen.";
"The server address is not a valid URL. Use a form like https://photos.example.com or http://192.168.1.10:2283." = "Serveradressen er ikke en gyldig URL. Bruk for eksempel https://photos.example.com eller http://192.168.1.10:2283.";
"The server answered with HTTP status %lld. Try again later." = "Serveren svarte med HTTP-status %lld. Prøv igjen senere.";
"The server could not be reached. Check the address and your network connection. (%@)" = "Fikk ikke kontakt med serveren. Sjekk adressen og nettverkstilkoblingen. (%@)";
"The server rejected the API key. Check that it is correct, has not been deleted, and has access to your library." = "Serveren avviste API-nøkkelen. Sjekk at den er riktig, ikke er slettet og har tilgang til biblioteket ditt.";

/* Service errors */
"Moving items to Recently Deleted isn't available on this server." = "Flytting av objekter til Nylig slettet er ikke tilgjengelig på denne serveren.";
"Could not reach the server: %@" = "Fikk ikke kontakt med serveren: %@";
"The server answered with HTTP status %lld." = "Serveren svarte med HTTP-status %lld.";
"The server rejected the API key." = "Serveren avviste API-nøkkelen.";
"The server sent a response that is not an Immich API response. Check the server URL." = "Serveren sendte et svar som ikke er fra Immich. Sjekk serveradressen.";
"The server URL is not valid." = "Serveradressen er ikke gyldig.";
"Bloom is set to view only. Turn on Allow Changes in the account menu to change your library." = "Bloom er satt til bare visning. Slå på Tillat endringer i kontomenyen for å endre biblioteket.";
"Server Redirected" = "Serveren videresendte";
"The server sent Bloom to a different address. Bloom doesn't follow it, so your API key stays with this server. Enter the address the server uses, for example with https://." = "Serveren sendte Bloom videre til en annen adresse. Bloom følger ikke etter, så API-nøkkelen blir hos denne serveren. Skriv inn adressen serveren bruker, for eksempel med https://.";
"Unencrypted Address" = "Ukryptert adresse";
"Bloom only uses http on your own network or Tailscale. Use https for this server." = "Bloom bruker bare http på ditt eget nettverk eller Tailscale. Bruk https for denne serveren.";
